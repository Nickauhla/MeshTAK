{
  "name": "meshtak-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Application tactique MeshTAK — une seule base de code Android + iOS (Svelte 5 + Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:vectors": "node ../shared/gen-vectors.ts",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap run android",
    "ios": "npm run sync && cap run ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^7.1.1",
    "@capacitor/android": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "@capacitor/ios": "^7.0.1",
    "maplibre-gl": "^5.1.0",
    "pmtiles": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
